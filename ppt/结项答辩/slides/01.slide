    </Text>
    <Box style={{ width: 420, height: 2, background: '#1E4FA8', marginTop: 26, marginBottom: 22 }} />
    <Text style={{ fontFamily: "'Microsoft YaHei'", fontSize: 19, color: '#4A5568', lineHeight: 1.8, width: 700 }}>
