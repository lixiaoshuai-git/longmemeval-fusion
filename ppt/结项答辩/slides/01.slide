  <Box style={{ position: 'absolute', left: 72, top: 76 }}>
    <Text style={{ fontFamily: "'Microsoft YaHei'", fontSize: 14, letterSpacing: 3, color: '#1E4FA8' }}>D.I.V.E. 计划 · 结项答辩</Text>
