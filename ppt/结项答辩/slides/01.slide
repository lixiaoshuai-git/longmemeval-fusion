    ))}
    {Array.from({ length: 12 }).map((_, i) => (
      <line key={`h${i}`} x1={760} y1={90 + i * 46} x2={1240} y2={90 + i * 46} stroke='#1E4FA8' strokeWidth='1' opacity='0.05' />
    ))}
    <circle cx='1000' cy='360' r='190' fill='none' stroke='#1E4FA8' strokeWidth='1' opacity='0.15' />
